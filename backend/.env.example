NODE_ENV=development
PORT=3000

# 数据源驱动：sqlite（本地开发/自动化测试，无需额外服务）| mysql（生产/正式部署）
# 权宜说明：当前沙箱环境无 Docker / 本地 MySQL 服务，V0 走骨架默认用 SQLite；
# 生产部署必须切换 DB_TYPE=mysql 并配置下方 DB_* 项，Entity/Migration 两驱动共用。
DB_TYPE=sqlite
DB_SQLITE_PATH=./data/dev.sqlite

# DB_TYPE=mysql 时需配置以下项
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=insurance_commission

# JWT 密钥：本地/测试可用随机字符串，生产环境务必替换为高强度随机值，禁止硬编码提交
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=8h

# 管理员账号（种子配置，非开放注册）：ADMIN_PASSWORD_HASH 用 bcrypt 生成，禁止填明文密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash-of-your-password
