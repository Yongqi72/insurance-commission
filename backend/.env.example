NODE_ENV=development
PORT=3000

# CORS 允许的来源白名单，逗号分隔（如 https://a.example.com,https://b.example.com）；
# 留空/未配置时默认仅放行本地开发的 Vite 服务器地址 http://localhost:5173，不影响本地开发体验；
# 已部署环境若前后端同源（经 nginx 反代），浏览器不发起跨域请求，此项不影响现有行为；
# 仅当前后端部署为不同域名时才需要在此配置生产域名
CORS_ALLOWED_ORIGINS=

# 数据源驱动：sqlite（本地开发/自动化测试，无需额外服务）| mysql（生产/正式部署）
# 权宜说明：当前沙箱环境无 Docker / 本地 MySQL 服务，V0 走骨架默认用 SQLite；
# 生产部署必须切换 DB_TYPE=mysql 并配置下方 DB_* 项，Entity/Migration 两驱动共用。
DB_TYPE=sqlite
DB_SQLITE_PATH=./data/dev.sqlite

# DB_TYPE=mysql 时需配置以下项
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=insurance_commission

# JWT 密钥：本地/测试可用随机字符串，生产环境务必替换为高强度随机值，禁止硬编码提交
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=8h

# 管理员账号（种子配置，非开放注册）：ADMIN_PASSWORD_HASH 用 bcrypt 生成，禁止填明文密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash-of-your-password

# 第三方回填接口地址：按工作单号批量回填销售人员姓名（POST，请求体 { workOrderNos: string[] }，
# 响应体为工作单号→销售人员姓名的映射对象）；留空/超时(5s)/调用异常
# 时相关保单记录一律保持 unmatched，不影响回填接口本身返回成功（TRD §接口：POST .../policy-records/fill）
SALES_FILL_API_URL=
# 第三方回填接口访问密钥：配置后调用上方接口时会携带请求头 X-Fill-Token: {密钥}，
# 须与服务端（如内网 IIS 上的 SalesFill.ashx）配置的校验密钥完全一致；留空则不携带该请求头
SALES_FILL_API_TOKEN=

# 阿里云 OSS（账单原始文件/导出报表归档，经 common/oss/OssClient 统一访问，BE-EXT-02）
# 测试 Bucket 与生产 Bucket 隔离，禁止指向生产 Bucket；本地未配置真实凭证时 OssClient 相关
# 功能不可用（见 ic-v1-001 完成报告 deviations：单测走 mock，真实联调留待部署/联调阶段）
OSS_BUCKET=replace-with-your-test-bucket
OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=
