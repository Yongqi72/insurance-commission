<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      调用方校验密钥：须与保险佣金系统后端环境变量 SALES_FILL_API_TOKEN 配置为完全一致的值。
      下方为占位值，部署前必须替换为高强度随机串（占位值以 change-me 开头时接口一律返回 401）。
      真实值禁止提交仓库。
    -->
    <add key="FillApiToken" value="change-me-to-a-random-token" />
    <!--
      数据访问模式开关：
        service —— 服务器部署用，经 Fcl.WSOP 服务中转查库（下方 SqlDbService* 四项生效）；
        direct  —— 本机开发用，直连内部库（下方 InternalDbConnectionString 生效）。
      未配置或其他值一律按 direct 处理。
    -->
    <add key="DbAccessMode" value="direct" />
    <!--
      内部库连接串（SQLOLEDB 格式，与 FalCode 内部系统访问方式一致，仅 direct 模式使用）：
      Data Source=内部 SQL Server 地址；Initial Catalog=库名；账号只需 SELECT 权限。
      下方为占位值，部署前替换；真实值禁止提交仓库。
    -->
    <add key="InternalDbConnectionString" value="Provider=SQLOLEDB;Data Source=127.0.0.1;User ID=change-me;Password=change-me;Initial Catalog=change-me;" />
    <!--
      服务模式配置（仅 service 模式使用，与 FalCode 的 sqldbop(服务地址) + Init(用户, 加密密码, 序列号) 用法一致）。
      下方均为占位值，部署前替换为环境真实值；真实值禁止提交仓库。
    -->
    <add key="SqlDbServiceUrl" value="http://127.0.0.1/falservice/sqldbservice.asmx" />
    <add key="SqlDbServiceUser" value="change-me" />
    <add key="SqlDbServicePassword" value="change-me" />
    <add key="SqlDbServiceSerial" value="change-me" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.0" />
    <!-- 请求体上限 1MB（足够 2000 个工作单号），执行超时 10s（须大于调用方 5s 阈值，避免 IIS 先掐断） -->
    <httpRuntime maxRequestLength="1024" executionTimeout="10" />
    <!-- 关闭默认错误页：异常时由处理程序自己输出 JSON，避免返回 HTML 错误页给调用方 -->
    <customErrors mode="Off" />
  </system.web>
</configuration>
